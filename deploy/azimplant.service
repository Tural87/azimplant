[Unit]
Description=Az Implant Group Flask application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/azimplant
EnvironmentFile=/var/www/azimplant/.env
ExecStart=/var/www/azimplant/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
